# VeriShield AI — Production Environment Configuration Template
#
# DO NOT put real values here. This file is committed to version control.
# All actual secrets must be injected via a managed secret store (Vault, AWS Secrets Manager,
# GCP Secret Manager, Azure Key Vault, or government-equivalent KMS).
#
# Usage:
#   1. Copy this file to your deployment configuration
#   2. Replace all <SET_VIA_SECRET_MANAGER> values with references to your secret store
#   3. NEVER commit the populated file to version control

# ---------------------------------------------------------------------------
# Admin authentication
# Must be a strong random secret — minimum 32 characters.
# Set via secret manager, never hardcoded.
# ---------------------------------------------------------------------------
VERISHIELD_ADMIN_PASSCODE=<SET_VIA_SECRET_MANAGER>

# ---------------------------------------------------------------------------
# Document identity hash salt
# Used for one-way hashing of document numbers to enable cross-document
# matching without storing the raw number.
# Must be a strong random secret — minimum 32 characters.
# ---------------------------------------------------------------------------
VERISHIELD_ID_SALT=<SET_VIA_SECRET_MANAGER>

# ---------------------------------------------------------------------------
# Database
# Production: PostgreSQL managed instance with SSL
# Format: postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
# ---------------------------------------------------------------------------
VERISHIELD_DB_URL=<SET_VIA_SECRET_MANAGER>

# ---------------------------------------------------------------------------
# CORS origins (comma-separated)
# Restrict to known production frontend origins only
# ---------------------------------------------------------------------------
VERISHIELD_CORS=https://verishield.example.gov.in

# ---------------------------------------------------------------------------
# Admin token TTL (seconds)
# Recommended: 3600 (1 hour) for production; shorter for high-security deployments
# ---------------------------------------------------------------------------
VERISHIELD_ADMIN_TOKEN_TTL=3600

# ---------------------------------------------------------------------------
# Upload directory (production: use mounted persistent volume)
# ---------------------------------------------------------------------------
VERISHIELD_UPLOADS=/data/uploads

# ---------------------------------------------------------------------------
# Upload TTL (seconds) — raw uploads are auto-deleted after this period
# Recommended: 900 (15 minutes) for privacy
# ---------------------------------------------------------------------------
VERISHIELD_UPLOAD_TTL=900

# ---------------------------------------------------------------------------
# OCR configuration
# ---------------------------------------------------------------------------
VERISHIELD_OCR_ENGINE=tesseract
VERISHIELD_OCR_LANGS=eng

# ---------------------------------------------------------------------------
# Optional: Structured log level
# ---------------------------------------------------------------------------
LOG_LEVEL=WARNING
